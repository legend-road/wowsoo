          <mxGeometry x="0" y="0" width="1240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="12" value="迦拉卡斯 — P1 攻塔流程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F8FAFC;fontSize=28;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="16" width="900" height="44" as="geometry" />
        </mxCell>
        <mxCell id="13" value="先左后右 · 专家破门约 90 秒 · 塔队：1 坦 + 1 奶 + 2~3 DPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#94A3B8;fontSize=19;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="14" value="⚠ 塔上正面技能会把人打下塔；库格鲁克三连弧形斩 / 达格瑞恩锁定方向连射" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FBBF24;fontSize=19;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="96" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="15" value="① 爆破专家&#xa;破左门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A5F;strokeColor=#38BDF8;strokeWidth=2;fontColor=#BAE6FD;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="16" value="② 打攻城车&#xa;再上塔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C2D12;strokeColor=#FB923C;strokeWidth=2;fontColor=#FFEDD5;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="17" value="③ 左塔&#xa;库格鲁克" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#E2E8F0;strokeWidth=2;fontColor=#F8FAFC;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="18" value="④ 左炮坦克&#xa;打始祖龙" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7F1D1D;strokeColor=#FCA5A5;strokeWidth=2;fontColor=#FEE2E2;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="19" value="⑤ 破右门&#xa;上右塔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A5F;strokeColor=#38BDF8;strokeWidth=2;fontColor=#BAE6FD;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="340" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="⑥ 右塔&#xa;达格瑞恩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#E2E8F0;strokeWidth=2;fontColor=#F8FAFC;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="340" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="21" value="⑦ 双炮齐射&#xa;拉下迦拉卡斯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#22C55E;strokeWidth=3;fontColor=#BBF7D0;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="680" y="340" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;【塔队】&lt;/b&gt;&#xa;&nbsp;&#xa;建议：1 坦 + 1 奶 + 2~3 DPS&#xa;&nbsp;&#xa;点绳子快速上塔（别只爬坡）&#xa;&nbsp;&#xa;小怪一并带上塔清掉&#xa;&nbsp;&#xa;左塔清完：坦克坐左炮打龙&#xa;&nbsp;&#xa;右塔清完：一人留右炮&#xa;&nbsp;&#xa;另一人回左炮 → 双人齐射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=16;fontColor=#F1F5F9;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="460" width="380" height="380" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;【塔上技能】&lt;/b&gt;&#xa;&nbsp;&#xa;库格鲁克：跑到平台中心&#xa;&nbsp;&#xa;连续 3 次弧形斩击退下塔&#xa;&nbsp;&#xa;雷霆一击叠减速（群体驱有用）&#xa;&nbsp;&#xa;&#xa;&nbsp;&#xa;达格瑞恩：地面提示锁定方向&#xa;&nbsp;&#xa;短间隔连射击退+伤害&#xa;&nbsp;&#xa;躲开正面锥形" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=16;fontColor=#FDE68A;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="450" y="460" width="360" height="380" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;【落龙时机】&lt;/b&gt;&#xa;&nbsp;&#xa;当前波清完&#xa;&nbsp;&#xa;或下一波来前&#xa;&nbsp;&#xa;别带一堆小怪进 P2&#xa;&nbsp;&#xa;波 7~8 之间窗口充足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#22C55E;align=left;verticalAlign=top;spacing=16;fontColor=#BBF7D0;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="840" y="460" width="360" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
