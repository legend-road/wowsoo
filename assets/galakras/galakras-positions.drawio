        <mxCell id="16" value="主T&#xa;红标" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#FECACA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="580" y="200" width="60" height="60" as="geometry" />
