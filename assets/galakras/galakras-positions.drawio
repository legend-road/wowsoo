        <mxCell id="33" value="&lt;b&gt;【红线】&lt;/b&gt;&#xa;&nbsp;&#xa;漏控骨折冲 NPC&#xa;&nbsp;&#xa;漏断治疗链&#xa;&nbsp;&#xa;旗帜/图腾不管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;align=left;verticalAlign=top;spacing=18;fontColor=#FECACA;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="920" y="420" width="280" height="240" as="geometry" />
