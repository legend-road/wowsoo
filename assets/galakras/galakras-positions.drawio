        <mxCell id="15" value="迦拉卡斯" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7F1D1D;strokeColor=#FCA5A5;strokeWidth=3;fontColor=#FEE2E2;fontStyle=1;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="555" y="280" width="110" height="110" as="geometry" />
