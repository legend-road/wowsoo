        <mxCell id="22" value="点名站后方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;fontColor=#FDE68A;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="400" y="640" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="23" value="点名站后方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;fontColor=#FDE68A;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="700" y="640" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;b&gt;【火球流程】&lt;/b&gt;&#xa;&nbsp;&#xa;1. 有人被「迦拉克隆之焰」点名&#xa;&nbsp;&#xa;2. 跑到本营后方等 5 秒 Debuff 结束&#xa;&nbsp;&#xa;3. 火球从 Boss 前飞向该位置&#xa;&nbsp;&#xa;4. 穿过本营被多人吸收减伤&#xa;&nbsp;&#xa;5. 触球者叠 DoT；两营轮流降层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=16;fontColor=#F1F5F9;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="160" width="300" height="380" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;【换坦】&lt;/b&gt;&#xa;&nbsp;&#xa;火球从 Boss 正前出现&#xa;&nbsp;&#xa;当前坦必吃一层&#xa;&nbsp;&#xa;约 3 层嘲讽换坦&#xa;&nbsp;&#xa;副坦站侧面勿穿球" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;align=left;verticalAlign=top;spacing=16;fontColor=#FECACA;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;【治疗】&lt;/b&gt;&#xa;&nbsp;&#xa;每秒团伤递增加&#xa;&nbsp;&#xa;约 4 万起，拖久可到 8 万级&#xa;&nbsp;&#xa;两营都要有奶&#xa;&nbsp;&#xa;P2 带满蓝 + 团减" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#22C55E;align=left;verticalAlign=top;spacing=16;fontColor=#BBF7D0;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="920" y="200" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;【层数过高】&lt;/b&gt;&#xa;&nbsp;&#xa;同营连吃多层时&#xa;&nbsp;&#xa;下次点名可把球&#xa;&nbsp;&#xa;放到另一营后方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=16;fontColor=#FDE68A;fontSize=18;" parent="1" vertex="1">
