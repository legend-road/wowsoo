          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="火球飞行路径" style="endArrow=classic;html=1;strokeWidth=4;strokeColor=#F97316;dashed=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
