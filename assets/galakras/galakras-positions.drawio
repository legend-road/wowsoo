        <mxCell id="13" value="嗜血 · 两营各约 4 人 · 坦克红点背对两营 · 火球穿营吸收" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#94A3B8;fontSize=19;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="14" value="⚠ 被点名者先跑到本营后方，Debuff 结束再回营；勿把 P1 小怪带进 P2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FBBF24;fontSize=19;fontStyle=1;" parent="1" vertex="1">
