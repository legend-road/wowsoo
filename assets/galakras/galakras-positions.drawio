          <mxGeometry x="680" y="250" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="18" value="A 营（蓝）约 4 人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A5F;fillOpacity=50;strokeColor=#38BDF8;strokeWidth=3;fontColor=#BAE6FD;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="380" y="480" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="19" value="B 营（绿）约 4 人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;fillOpacity=50;strokeColor=#22C55E;strokeWidth=3;fontColor=#86EFAC;fontSize=16;fontStyle=1;" parent="1" vertex="1">
