        <mxCell id="12" value="迦拉卡斯 — P2 两营分摊" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F8FAFC;fontSize=28;fontStyle=1;" parent="1" vertex="1">
