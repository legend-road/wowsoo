        <mxCell id="25" value="&lt;b&gt;【肿胀前】&lt;/b&gt;&#xa;&nbsp;&#xa;1. 报个人傲慢档&#xa;&nbsp;&#xa;2. 低档集合方便治疗减伤落地&#xa;&nbsp;&#xa;3. ≥75 提前离开大团&#xa;&nbsp;&#xa;4. 交团灭 / 屏障 / 个人大红" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="340" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;【红线】&lt;/b&gt;&#xa;&nbsp;&#xa;100 傲慢吃肿胀 = 心控&#xa;&nbsp;&#nbsp;&#xa;投影漏踩 = 全团暗影伤 +5 傲慢&#xa;&nbsp;&#xa;脚下圈不跑 = 自爆 +5&#xa;&nbsp;&#xa;光环贴人 = 每秒脉冲伤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;align=left;verticalAlign=top;spacing=18;fontColor=#FECACA;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="860" y="340" width="330" height="300" as="geometry" />
        </mxCell>
        <mxCell id="27" value="正常进度不该摸到 75+；若接近，肿胀前必须先散开。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FBBF24;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="660" width="720" height="40" as="geometry" />
        </mxCell>
      </root>
