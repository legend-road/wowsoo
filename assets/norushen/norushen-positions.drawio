        <mxCell id="314" value="&lt;b&gt;【冰寒恐惧】&lt;/b&gt;&#xa;&nbsp;&#xa;约每 3 秒魔法团伤&#xa;&nbsp;&#xa;Boss 血越低越高&#xa;&nbsp;&#xa;大约 10 万 → 25 万&#xa;&nbsp;&#xa;尾段奶压是硬指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=18;fontColor=#FDE68A;fontSize=20;" parent="1" vertex="1">
