        <mxCell id="111" value="近1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#BFDBFE;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" parent="1" vertex="1">
