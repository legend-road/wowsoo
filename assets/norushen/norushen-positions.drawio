        <mxCell id="30" value="集合区（盲仇后归位）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;fillOpacity=30;strokeColor=#22C55E;strokeWidth=2;dashed=1;fontColor=#86EFAC;fontSize=16;" parent="1" vertex="1">
