  <diagram id="npage3" name="3-试炼虚空">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="201" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B1220;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="0" y="0" width="1240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="202" value="诺鲁什 — 10H 试炼编组与虚空节奏" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F8FAFC;fontSize=28;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="16" width="920" height="44" as="geometry" />
        </mxCell>
        <mxCell id="203" value="四球轮换 · 同波 DPS 错开先大 / 先小 · 虚空：坦 → 奶 → 净化坦连踩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#94A3B8;fontSize=19;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="204" value="⚠ 同波双大怪回场极易灭团；计划完成前禁止压破 50%" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FBBF24;fontSize=19;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="96" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="205" value="&lt;b&gt;【波 1 · 同时进】&lt;/b&gt;&#xa;&nbsp;&#xa;人员：T1 · H1 · D1 · D2&#xa;&nbsp;&#xa;占用 4 个黄球&#xa;&nbsp;&#xa;D1：先打大怪，再打小怪&#xa;&nbsp;&#xa;D2：先打小怪，再打大怪&#xa;&nbsp;&#xa;目的：错开大怪回场时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="206" value="&lt;b&gt;【波 2】&lt;/b&gt;&#xa;&nbsp;&#xa;人员：T2 · H2 · D3 · D4&#xa;&nbsp;&#xa;同样错开大怪击杀顺序&#xa;&nbsp;&#xa;场上继续处理回场大 / 小怪&#xa;&nbsp;&#xa;虚空按表踩掉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="440" y="150" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="207" value="&lt;b&gt;【波 3】&lt;/b&gt;&#xa;&nbsp;&#xa;人员：双坦轮换 + D5 / D6&#xa;&nbsp;&#xa;可一人一波，或视输出并进&#xa;&nbsp;&#xa;Boss 接近 50%：停试炼推血&#xa;&nbsp;&#xa;勿与磨损大怪叠在一起" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="840" y="150" width="370" height="320" as="geometry" />
        </mxCell>
        <mxCell id="208" value="&lt;b&gt;【虚空踩摊表】&lt;/b&gt;&#xa;&nbsp;&#xa;第 1 摊（D1 大怪死后）：当前坦克踩 → 坦变 100 腐蚀&#xa;&nbsp;&#xa;第 2 摊（D2）：治疗 2 踩（非戒律 / 织雾优先）&#xa;&nbsp;&#xa;之后：刚净化完的坦克可连踩最多约 4 摊&#xa;&nbsp;&#xa;应急：指定治疗备援；DPS 仅绝境才踩&#xa;&nbsp;&#xa;条件：个人腐蚀 ≤75 才能踩掉虚空&#xa;&nbsp;&#xa;效果：每摊虚空 +25 腐蚀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="500" width="580" height="360" as="geometry" />
        </mxCell>
        <mxCell id="209" value="&lt;b&gt;【试炼内速查】&lt;/b&gt;&#xa;&nbsp;&#xa;坦克：断投掷 · 躲砸击&#xa;&nbsp;&#xa;治疗：驱散残留腐化 · 保 NPC&#xa;&nbsp;&#xa;DPS：75 腐 = 1 大 + 3 小&#xa;&nbsp;&#xa;回场大怪约 620 万 · 优先转火&#xa;&nbsp;&#xa;小怪挡弹道（约 13 万）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="660" y="500" width="550" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="npage4" name="4-磨损阶段">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
