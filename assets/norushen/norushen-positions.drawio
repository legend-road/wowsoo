          <mxGeometry x="560" y="645" width="54" height="54" as="geometry" />
        </mxCell>
        <mxCell id="116" value="&lt;b&gt;【处理步骤】&lt;/b&gt;&#xa;&nbsp;&#xa;1. 光束先无伤示警几秒&#xa;&nbsp;&#xa;2. 看清旋转方向&#xa;&nbsp;&#xa;3. 全团绕到 Boss 背后&#xa;&nbsp;&#xa;4. 跟着慢转，勿穿越激光&#xa;&nbsp;&#xa;5. 当前光束消前可一直待背后&#xa;&nbsp;&#xa;6. 治疗标记方便归位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=18;fontColor=#F1F5F9;fontSize=20;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="320" height="460" as="geometry" />
        </mxCell>
        <mxCell id="117" value="&lt;b&gt;【注意】&lt;/b&gt;&#xa;&nbsp;&#xa;减伤救不了硬吃激光&#xa;&nbsp;&#xa;必须靠站位躲开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=18;fontColor=#FDE68A;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="920" y="320" width="290" height="180" as="geometry" />
        </mxCell>
