        <mxCell id="114" value="治疗2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#BBF7D0;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="595" y="585" width="52" height="52" as="geometry" />
        </mxCell>
