        <mxCell id="301" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B1220;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="0" y="0" width="1240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="302" value="诺鲁什 — 10H 50% 后磨损阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F8FAFC;fontSize=28;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="16" width="820" height="44" as="geometry" />
        </mxCell>
        <mxCell id="303" value="每 10% 一只磨损大怪（伤不转 Boss）· 优先转火 · 顶冰寒恐惧" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#94A3B8;fontSize=19;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="304" value="⚠ 磨损大怪必须当场处理；冰寒恐惧随 Boss 降血越来越痛" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FBBF24;fontSize=19;fontStyle=1;" parent="1" vertex="1">
