        <mxCell id="c0_13" value="⚠ 吐息是弧形斩后续，看成一套；内爆空炸可灭" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FBBF24;fontSize=18;fontStyle=1;" parent="1" vertex="1">
