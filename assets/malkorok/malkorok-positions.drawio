        <mxCell id="c0_12" value="约 2:20 · 踩内爆 · 斩后出吐息 · 瘴气按吸收抬" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#94A3B8;fontSize=18;" parent="1" vertex="1">
