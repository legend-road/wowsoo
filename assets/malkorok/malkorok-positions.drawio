        <mxCell id="c0_11" value="马尔考罗克 — P1 站位" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F8FAFC;fontSize=26;fontStyle=1;" parent="1" vertex="1">
