        <mxCell id="c0_16" value="&lt;b&gt;内爆能量&lt;/b&gt;&#xa;&nbsp;&#xa;虚空必须有人踩，否则爆炸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#450A0A;strokeColor=#EF4444;align=left;verticalAlign=top;spacing=14;fontColor=#F1F5F9;fontSize=17;" parent="1" vertex="1">
