        </mxCell>
        <mxCell id="c0_14" value="&lt;b&gt;【要点】&lt;/b&gt;&#xa;&nbsp;&#xa;开场嗜血&#xa;&nbsp;&#xa;内爆虚空必须踩&#xa;&nbsp;&#xa;弧形斩后立刻出吐息&#xa;&nbsp;&#xa;免疫清精华球&#xa;&nbsp;&#xa;猛击出腐蚀速清&#xa;&nbsp;&#xa;假血按盾/吸收抬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#64748B;align=left;verticalAlign=top;spacing=16;fontColor=#F1F5F9;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="340" height="520" as="geometry" />
        </mxCell>
        <mxCell id="c0_15" value="&lt;b&gt;【注意】&lt;/b&gt;&#xa;&nbsp;&#xa;吐息=斩后通道&#xa;&nbsp;&#xa;第一轮最弱吃满嗜血" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#422006;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=16;fontColor=#FDE68A;fontSize=18;" parent="1" vertex="1">
          <mxGeometry x="40" y="690" width="340" height="170" as="geometry" />
