        <mxCell id="c0_17" value="&lt;b&gt;亚煞极之息&lt;/b&gt;&#xa;&nbsp;&#xa;弧形斩后通道致死，全体离开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7F1D1D;strokeColor=#FCA5A5;align=left;verticalAlign=top;spacing=14;fontColor=#F1F5F9;fontSize=17;" parent="1" vertex="1">
